# Server
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/scraper.db
# If set, every /api request must send this value in the x-api-key header
API_KEY=
MAX_CONCURRENT_JOBS=3

# Browser
USER_AGENT=SelfHealingScraper/1.0
RESPECT_ROBOTS=true
# Only set to true on a trusted dev machine. It disables the private-network (SSRF) block.
ALLOW_PRIVATE_NETWORK=false
# Optional: use a Chromium you installed yourself
SCRAPER_CHROMIUM_PATH=
SCRAPER_CHROMIUM_ARGS=

# Vision recovery (optional). Without a key, only DOM recovery runs.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
