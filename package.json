{
  "name": "self-healing-web-scraper",
  "version": "1.0.0",
  "description": "Web scraper that detects extraction failures and repairs its own selectors using DOM and vision evidence",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "scrape": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:browser": "playwright install chromium"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "fastify": "^5.12.7",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
